// A uvec4 copied out of the block first, then indexed by a component picked at run time.
// expect: {i: U(i) for i in range(64)}
#version 460
layout (local_size_x = 64) in;
layout (std140, binding = 0) uniform Block { uvec4 v[16]; };
layout (std430, binding = 0) buffer Out { uint words[64]; };
void main()
{
    uint i = gl_LocalInvocationIndex;
    uvec4 copy = v[i >> 2];
    words[i] = copy[i & 3u];
}
