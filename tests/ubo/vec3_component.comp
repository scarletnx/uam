// A uvec3 array, one 16-byte slot per vector, read by a component picked at run time.
// expect: {i: U(4 * (i >> 2) + min(i & 3, 2)) for i in range(64)}
#version 460
layout (local_size_x = 64) in;
layout (std140, binding = 0) uniform Block { uvec3 v[16]; };
layout (std430, binding = 0) buffer Out { uint words[64]; };
void main()
{
    uint i = gl_LocalInvocationIndex;
    words[i] = v[i >> 2][min(i & 3u, 2u)];
}
