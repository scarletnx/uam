// A std140 array of scalars, one 16-byte slot each.
// expect: {i: U(4 * i) for i in range(64)}
#version 460
layout (local_size_x = 64) in;
layout (std140, binding = 0) uniform Block { uint s[64]; };
layout (std430, binding = 0) buffer Out { uint words[64]; };
void main()
{
    uint i = gl_LocalInvocationIndex;
    words[i] = s[i];
}
