// An element of a row-major mat4 in a storage buffer with its column and its row picked at run time.
// expect: {i: S(16 * (i >> 4) + 4 * (i & 3) + ((i >> 2) & 3)) for i in range(64)}
#version 460
layout (local_size_x = 64) in;
layout (std430, row_major, binding = 1) readonly buffer In { mat4 m[4]; };
layout (std430, binding = 0) buffer Out { uint words[64]; };
void main()
{
    uint i = gl_LocalInvocationIndex;
    words[i] = floatBitsToUint(m[i >> 4][(i >> 2) & 3u][i & 3u]);
}
