// A bvec4 array read by a component picked at run time.
// ubo: 0 if w % 3 == 0 else 0x1000 + w
// expect: {i: 1 if U(i) else 0 for i in range(64)}
#version 460
layout (local_size_x = 64) in;
layout (std140, binding = 0) uniform Block { bvec4 b[16]; };
layout (std430, binding = 0) buffer Out { uint words[64]; };
void main()
{
    uint i = gl_LocalInvocationIndex;
    words[i] = b[i >> 2][i & 3u] ? 1u : 0u;
}
