#version 460

// A compute program's uniform block and storage buffer, for tests/nvn/check.py.

layout (local_size_x = 8) in;

layout (std140, binding = 0) uniform Block
{
    uint value;
} block;

layout (std430, binding = 0) writeonly buffer Out
{
    uint words[];
};

void main()
{
    words[gl_GlobalInvocationID.x] = block.value;
}
